# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets.
# Source real values from the team password manager (1Password / Doppler / etc.).
# See docs/04-access/secrets-inventory.md for the source of truth.

# --- Application ---
APP_ENV=development
APP_PORT=3000
LOG_LEVEL=debug

# --- Database ---
DATABASE_URL=postgres://localhost:5432/myapp_dev

# --- Third-party services ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# SENTRY_DSN=
